# Hostname Caddy serves and gets a certificate for (DNS must point at this server).
EVLOGGER_DOMAIN=evlogger.example.com

# Signs login tokens. Generate with: openssl rand -hex 32
API_SECRET_KEY=

# Who may reach EVLogger: space-separated CIDRs, or Caddy's shortcut "private_ranges" (LAN only).
# Add your VPN subnet here, e.g. "private_ranges 10.8.0.0/24".
EVLOGGER_ALLOWED_IPS=private_ranges

# Host ports, if 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
